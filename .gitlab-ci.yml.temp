stages:
- build
- test
- deploy

variables:
  DOCKERFILE_PATH: ./docker
  API_IMAGE: $CI_REGISTRY/$CI_PROJECT_PATH/api
  API_SRC_PATH: ./
  API_STAGING_URL: http://api.staging.demasterprocloud.3si.vn/
  API_DEV_URL: http://api.dev.demasterprocloud.3si.vn/
  API_RELEASE_VLAB_URL: http://api.vlab.demasterprocloud.3si.vn/
  API_RELEASE_DUALI_URL: http://api.duali.dmpc.3si.vn:8080/
  API_VLAB_RELEASE_DEST_PATH: /data/api
  API_DUALI_RELEASE_DEST_PATH: /data/api
  COMPOSE_TLS_VERSION: "TLSv1_2"
before_script:
  - export DATE=$(date +%Y.%m.%d)

api.build:
  stage: build
  image: docker:git
  services:
    - docker:dind
  tags:
    - docker-vlab
  script:
    - docker login $CI_REGISTRY -u gitlab-ci-token -p $CI_JOB_TOKEN
    - docker build -f $DOCKERFILE_PATH/staging.Dockerfile -t $API_IMAGE:$CI_COMMIT_REF_SLUG $API_SRC_PATH
    - docker push $API_IMAGE:$CI_COMMIT_REF_SLUG
  only:
    - staging
    - develop

api.build.release-vlab:
  stage: build
  image: docker:git
  services:
    - docker:dind
  tags:
    - docker-vlab
  before_script:
    - docker login $CI_REGISTRY -u gitlab-ci-token -p $CI_JOB_TOKEN
    - docker build -f $DOCKERFILE_PATH/staging.Dockerfile -t $API_IMAGE:$CI_COMMIT_REF_SLUG $API_SRC_PATH
    - docker push $API_IMAGE:$CI_COMMIT_REF_SLUG
  script:
    - rm -rf release-vlab
    - docker create -ti --name dummy $API_IMAGE:$CI_COMMIT_REF_SLUG bash
    - docker cp dummy:/app/ release-vlab/
    - docker rm -fv dummy
  artifacts:
    paths:
      - release-vlab
  only:
    - release/vlab

api.build.release-duali:
  stage: build
  image: docker:git
  services:
    - docker:dind
  tags:
    - docker-vlab
  before_script:
    - docker login $CI_REGISTRY -u gitlab-ci-token -p $CI_JOB_TOKEN
    - docker build -f $DOCKERFILE_PATH/staging.Dockerfile -t $API_IMAGE:$CI_COMMIT_REF_SLUG $API_SRC_PATH
    - docker push $API_IMAGE:$CI_COMMIT_REF_SLUG
  script:
    - rm -rf release-duali
    - docker create -ti --name dummy $API_IMAGE:$CI_COMMIT_REF_SLUG bash
    - docker cp dummy:/app/ release-duali/
    - docker rm -fv dummy
  artifacts:
    paths:
      - release-duali
  only:
    - release/duali

api.deploy.release-duali:
  stage: deploy
  environment:
    name: API duali Release
    url: $API_RELEASE_DUALI_URL
  image: governmentpaas/git-ssh:latest
  dependencies: 
    - api.build.release-duali
  tags:
    - docker-vlab
  before_script:
    - mkdir -p ~/.ssh
    - echo "$SERVER_PRIVATE_KEY_DUALI" | tr -d '\r' > ~/.ssh/id_rsa
    - chmod 600 ~/.ssh/id_rsa
    - eval "$(ssh-agent -s)"
    - ssh-add ~/.ssh/id_rsa
    - ssh-keyscan -p $SERVER_HOST_DUALI_SSH_PORT -H $SERVER_HOST_DUALI > ~/.ssh/known_hosts
  script:
    - echo "$RELEASE_DUALI_API_CONFIG" > release-duali/appsettings.Production.json
    - echo "$RELEASE_DUALI_API_CONFIG" > release-duali/appsettings.Development.json
    - scp -o StrictHostKeyChecking=no -P $SERVER_HOST_DUALI_SSH_PORT -r release-duali/. root@${SERVER_HOST_DUALI}:$API_DUALI_RELEASE_DEST_PATH/
    - ssh -o StrictHostKeyChecking=no -p $SERVER_HOST_DUALI_SSH_PORT root@$SERVER_HOST_DUALI "systemctl restart dmpc-api.service"
  only:
    - release/duali

api.deploy.release-vlab:
  stage: deploy
  environment:
    name: API Vlab Release
    url: $API_RELEASE_VLAB_URL
  image: governmentpaas/git-ssh:latest
  dependencies: 
    - api.build.release-vlab
  tags:
    - docker-vlab
  before_script:
    - mkdir -p ~/.ssh
    - echo "$SERVER_PRIVATE_KEY_235" | tr -d '\r' > ~/.ssh/id_rsa
    - chmod 600 ~/.ssh/id_rsa
    - eval "$(ssh-agent -s)"
    - ssh-add ~/.ssh/id_rsa
    - ssh-keyscan -H $SERVER_HOST_235 > ~/.ssh/known_hosts
  script:
    - echo "$RELEASE_VLAB_API_CONFIG" > release-vlab/appsettings.Production.json
    - echo "$RELEASE_VLAB_API_CONFIG" > release-vlab/appsettings.Development.json
    - scp -r release-vlab/. root@${SERVER_HOST_235}:$API_VLAB_RELEASE_DEST_PATH/
    - ssh root@$SERVER_HOST_235 "systemctl restart dmpc-api.service"
  only:
    - release/vlab

api.deploy.staging:
  stage: deploy
  environment:
    name: API Staging
    url: $API_STAGING_URL
  image: jonaskello/docker-and-compose:latest
  tags:
    - docker-vlab
  script:
    - mkdir $DOCKER_CERT_PATH
    - echo "$CA" > $DOCKER_CERT_PATH/ca.pem
    - echo "$CLIENT_CERT" > $DOCKER_CERT_PATH/cert.pem
    - echo "$CLIENT_KEY" > $DOCKER_CERT_PATH/key.pem
    - echo "$DOCKER_COMPOSE_STAGING" > ./docker-compose.yml
    - docker login $CI_REGISTRY -u gitlab-ci-token -p $CI_JOB_TOKEN
    - docker-compose pull api.staging
    - docker-compose up -d api.staging
    - rm -rf $DOCKER_CERT_PATH
  variables:
    DOCKER_TLS_VERIFY: "1"
    DOCKER_HOST: "tcp://$SERVER_HOST:2376"
    DOCKER_CERT_PATH: "certs"
  only:
    - staging

api.deploy.dev:
  stage: deploy
  environment:
    name: API Development
    url: $API_DEV_URL
  image: jonaskello/docker-and-compose:latest
  tags:
    - docker-vlab
  script:
    - mkdir $DOCKER_CERT_PATH
    - echo "$CA_234" > $DOCKER_CERT_PATH/ca.pem
    - echo "$CLIENT_CERT_234" > $DOCKER_CERT_PATH/cert.pem
    - echo "$CLIENT_KEY_234" > $DOCKER_CERT_PATH/key.pem
    - echo "$DOCKER_COMPOSE_DEVELOP" > ./docker-compose.yml
    - docker login $CI_REGISTRY -u gitlab-ci-token -p $CI_JOB_TOKEN
    - docker-compose pull api-develop
    - docker-compose up -d api-develop
    - rm -rf $DOCKER_CERT_PATH
  variables:
    COMPOSE_TLS_VERSION: "TLSv1_2"
    DOCKER_TLS_VERIFY: "1"
    DOCKER_HOST: "tcp://$SERVER_HOST_234:2376"
    DOCKER_CERT_PATH: "certs"
  only:
    - develop